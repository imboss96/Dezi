{
  "name": "dezhub-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/server.js",
    "lint": "eslint .",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@supabase/server": "^1.5.2",
    "@supabase/supabase-js": "latest",
    "dotenv": "latest",
    "fastify": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "latest",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
